# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/

_build/
_deps/

# Virtual environments
.venv/

_build
_deps
.benchmarks
worktrees/

# Generated files
*.pyi
*.so
py.typed

# 型スタブは nanobind の stubgen で生成するが、PEP 561 の解決順で
# webtransport/__init__.py を隠さないようスタブパッケージとして配置し、
# 型検査をビルド成果物に依存させないため追跡する
!src/webtransport/webtransport_ext/
!src/webtransport/webtransport_ext/*.pyi

.DS_Store

# pytest-playwright の成果物出力先
test-results/

# Agents
.claude/

# ローカル作業用の一時ディレクトリ (uv のキャッシュ・ツール設置先など)
.tmp/
.uv-cache/
.uv-tools/
.prek/
